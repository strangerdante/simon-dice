<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Simón Dice 3D</title>
  </head>

  <body class="bg-[#0b0d14] text-white overflow-hidden select-none">
    <!-- Lienzo donde Three.js dibuja el tablero -->
    <canvas id="scene" class="fixed inset-0 block w-full h-full touch-none"
    ></canvas>

    <!-- Fogonazo rojo en los bordes al perder -->
    <div
      id="hitFlash"
      class="pointer-events-none fixed inset-0 opacity-0"
      style="background: radial-gradient(ellipse at center, transparent 45%, rgba(220,38,38,.55) 100%);"
    >
    </div>

    <header class="pointer-events-none fixed top-0 inset-x-0 p-6 text-center">
      <h1 class="text-xs tracking-[0.35em] uppercase text-gray-400">
        Simón dice
      </h1>
      <p id="maxLevelDisplay" class="mt-1 text-lg font-semibold">
        Nivel máximo alcanzado: 0
      </p>
    </header>

    <p
      class="pointer-events-none fixed bottom-0 inset-x-0 p-6 text-center text-xs text-gray-500"
    >
      Toca el centro para empezar · Teclado: Q W A S (Enter para empezar)
    </p>

    <!-- Estado del juego para lectores de pantalla -->
    <p id="status" class="sr-only" aria-live="polite"></p>

    <script>
      import "../scripts/simon3d.js";
    </script>
  </body>
</html>
